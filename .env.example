# Client (Vite). Never put service_role or Anthropic keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Netlify site env, or functions/.env for Firebase Cloud Functions).
# Direct Anthropic SDK — this bypasses Netlify AI Gateway by design.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
