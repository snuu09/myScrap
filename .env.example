# Client (Vite). Never put service_role or Anthropic keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AdMob banner on web uses Google AdSense tags (ca-pub publisher + slot from AdMob/AdSense console).
VITE_ADMOB_PUBLISHER_ID=
VITE_ADMOB_BANNER_SLOT=

# Server only — local `npm run dev` loads these for the Netlify Vite plugin
# so POST /api/analyze hits netlify/functions/analyze.ts (Claude).
# Also: Netlify site env, or functions/.env for Firebase Cloud Functions (needs Blaze).
# Direct Anthropic SDK — this bypasses Netlify AI Gateway by design.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
