# Client (Vite). Never put service_role or Anthropic keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AdMob banner on web uses Google AdSense tags (ca-pub publisher + slot from AdMob/AdSense console).
VITE_ADMOB_PUBLISHER_ID=
VITE_ADMOB_BANNER_SLOT=

# Server only. Live classify reads ANTHROPIC_API_KEY as a Supabase secret
# (function `analyze`), not from Vite. The root value is only a local copy
# used to set that secret. Never prefix it with VITE_.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
